# LLM 配置：复制成 llm.env 后填 key，本文件不要提交密钥
#   cp config/llm.env.example config/llm.env
# 统一走 OpenAI 兼容格式，换平台只改 BASE_URL / KEY / MODEL 三个变量，代码不动。
#
# 体检：python3 bin/llm-smoke.py

# ---------------- 主用：SiliconFlow ----------------
LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
# 编排大脑：中文稳 + tool calling 可靠（实测强制工具调用返回标准 tool_calls）
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# 副手：文案/标题（JSON 模式干净，但会带 reasoning_content，慢一点）
LLM_MODEL_FAST=Qwen/Qwen3.5-35B-A3B
# 编码改脚本
LLM_MODEL_CODE=Qwen/Qwen3-Coder-30B-A3B-Instruct
# 画面质检（抽帧审片）
LLM_MODEL_VISION=Qwen/Qwen3-VL-32B-Instruct

# TTS：已移除。云端 TTS 效果不达标，配音改走本地方案（ComfyUI 的 TTS 节点 /
# IndexTTS / F5-TTS），显存由 comfy_guard 统一调度。

# ---------------- 备用：ModelScope（主用挂了自动切）----------------
LLM_FALLBACK_PROVIDER=modelscope
LLM_FALLBACK_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=Qwen/Qwen3.8-27B

# ⚠️ 边界：词级时间戳（剪映级逐词高亮的前提）**没有任何聊天模型能给**。
#    LLM 只能按字数估算，字幕一定对不上嘴。
#    必须走 ASR 强制对齐：ComfyUI 的 Qwen3-ASR 节点 / faster-whisper / WhisperX
#    → 产出 words.json → captions/capcut_ass.py → ASS → ffmpeg 烧录
