{
  "name": "ComfyUI + 字幕烧录 编排",
  "nodes": [
    {
      "id": "a1",
      "name": "Webhook 触发",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "gen",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "gen"
    },
    {
      "id": "b1",
      "name": "调用 ComfyUI 生成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "parameters": {
        "url": "http://host.docker.internal:8000/generate",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "workflow", "value": "={{ $json.body.workflow }}" },
            { "name": "prompt", "value": "={{ $json.body.prompt }}" },
            { "name": "width", "value": "={{ $json.body.width }}" },
            { "name": "height", "value": "={{ $json.body.height }}" },
            { "name": "length", "value": "={{ $json.body.length }}" },
            { "name": "seed", "value": "={{ $json.body.seed }}" },
            { "name": "reference_image", "value": "={{ $json.body.reference_image }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c1",
      "name": "字幕烧录 (ffmpeg+ASS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "parameters": {
        "url": "http://host.docker.internal:8000/burn",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "video_path", "value": "={{ $json.output_path }}" },
            { "name": "subtitle_path", "value": "={{ $('Webhook 触发').first().json.body.subtitle_path }}" },
            { "name": "font_size", "value": "={{ $('Webhook 触发').first().json.body.font_size }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d1",
      "name": "返回结果",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [960, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Webhook 触发": {
      "main": [[{ "node": "调用 ComfyUI 生成", "type": "main", "index": 0 }]]
    },
    "调用 ComfyUI 生成": {
      "main": [[{ "node": "字幕烧录 (ffmpeg+ASS)", "type": "main", "index": 0 }]]
    },
    "字幕烧录 (ffmpeg+ASS)": {
      "main": [[{ "node": "返回结果", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "versionId": "comfy-kdenlive-v1",
  "meta": { "templateId": "comfy-kdenlive" },
  "id": "comfy-kdenlive-stack"
}
