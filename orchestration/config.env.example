# ComfyUI 地址（本机单独跑，独占 4080）
COMFYUI_SERVER_URL=http://localhost:8188

# OpenMontage 已打包的 workflow 目录（默认指向你克隆的仓库）
COMFYUI_WORKFLOWS_DIR=/home/qmr/github/ai-video-studio/OpenMontage/tools/_comfyui/workflows

# 生成产物根目录
OUTPUT_DIR=/home/qmr/github/ai-video-studio/orchestration/output

# ComfyUI 单次生成等待上限（秒）——本地 GPU 慢可加大
POLL_TIMEOUT=3600
POLL_INTERVAL=5

# ---- 资源护栏（防崩盘，详见 docs/RESOURCE_GUARD.md）----
# 提交任务前预检：资源不够先自动释放，释放后仍不够就拒绝（不白烧 GPU 时间）
COMFY_AUTO_GUARD=1
# 任务结束后按需腾资源（只在余量 < 水位1.5倍时才真释放，避免连续作业时反复加载模型）
COMFY_AUTO_RELEASE=1
# 水位：跑 WAN/FLUX 这类大模型建议把内存抬到 25~30
GUARD_MIN_RAM_GB=12
GUARD_MIN_VRAM_GB=6
