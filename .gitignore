# 密钥与本地配置（绝不提交）
config/llm.env
orchestration/.env
*.env
!.env.example

# 运行时
__pycache__/
*.pyc
.venv/
output/
*.log
*.pid

# ★ 档案卡里的大文件：进 git 会让仓库迅速膨胀，且二进制 diff 无意义
#   成片 / 过程文件 / 音频 / 视频 —— 一律不提交，靠文件系统与备份管
#
#   注意：写 `profiles/*/07_成片/` 会让 git **完全不进入该目录**，
#   于是下面的 !.../*.md 例外规则也会失效（git 不会去看被排除目录里的内容）。
#   所以这里必须写成 `/**` 形式，才能单独把 `制作记录.md` 放进来。
profiles/*/07_成片/**
# 制作记录是文档不是成片，必须留。但 git 铁律：**目录一旦被排除就不再往里看**，
# 后面的 !...md 根本不会被评估。所以要先逐级把目录放回来，再放回 md。
!profiles/*/07_成片/
!profiles/*/07_成片/*/
!profiles/*/07_成片/**/*.md
profiles/*/08_过程/**
profiles/*/资产/**
profiles/*/06_音频/**
profiles/*/02_素材真值/**
profiles/*/03_生产脚本/*.mp4
profiles/*/03_生产脚本/*.wav
profiles/*/03_生产脚本/*.ass
*.mp4
*.mp3
*.wav
*.flac
*.png
*.ttf

# 索引是派生物，每次 index 命令重生成
jobs.index.json

# 字幕样式等中间产物
orchestration/subtitles/
OpenMontage
